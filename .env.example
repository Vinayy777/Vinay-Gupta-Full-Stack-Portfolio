# GEMINI_API_KEY: Required for Gemini AI API calls (Assistant chatbot & Architecture deep-dives)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Application Server Port
PORT=3001

# GOOGLE_SHEET_WEBHOOK_URL: (Optional) Google Apps Script Webhook URL to automatically append all incoming messages to a Google Sheet
GOOGLE_SHEET_WEBHOOK_URL=""

# ADMIN_PIN: 4-digit PIN required to view and manage received inquiries on the website (Default: 1234)
ADMIN_PIN="1234"
